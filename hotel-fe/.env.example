# ========================================================
# ENVIRONMENT VARIABLES TEMPLATE (HOTEL FRONTEND & SERVER)
# ========================================================
# HƯỚNG DẪN: Copy file này thành .env hoặc cấu hình trong GitHub Secrets.
# KHÔNG commit file .env chứa thông tin thật lên Git!

# 1. API & Backend Service
VITE_API_URL=http://localhost:8080/api/v1
VITE_APP_ENV=development

# 2. Cổng thanh toán & Ngân hàng VietQR
VITE_BANK_ID=MB
VITE_BANK_ACCOUNT_NO=098888899
VITE_BANK_ACCOUNT_NAME=GRAND HOTEL AND RESORTS

# 3. Server Deploy Path
SERVER_DEPLOY_PATH=/var/www/hotel-fe
