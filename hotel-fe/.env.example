# ========================================================
# ENVIRONMENT VARIABLES TEMPLATE (HOTEL FRONTEND & SERVER)
# ========================================================
# HƯỚNG DẪN: Copy file này thành .env hoặc cấu hình trong GitHub Secrets.
# KHÔNG commit file .env chứa thông tin thật lên Git!

# 1. API & Backend Service
VITE_API_URL=https://api.grandhotel.vn
VITE_APP_ENV=production

# 2. Cổng thanh toán & Ngân hàng VietQR
VITE_BANK_ID=MB
VITE_BANK_ACCOUNT_NO=098888899
VITE_BANK_ACCOUNT_NAME=GRAND HOTEL AND RESORTS

# 3. Database Credentials (Dành cho Backend / Server nội bộ)
# (LƯU Ý: Frontend Vite không kết nối DB trực tiếp, nhưng biến này được quản lý qua GitHub Secrets)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=grand_hotel_db
DB_USER=hotel_admin
DB_PASSWORD=your_secure_db_password_here

# 4. Server Deploy Path
SERVER_DEPLOY_PATH=/var/www/hotel-fe
