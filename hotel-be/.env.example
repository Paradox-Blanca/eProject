# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/grand_hotel
DB_USERNAME=grand_hotel
DB_PASSWORD=replace-with-a-strong-password

# Generate at least 32 random bytes, for example: openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-long-random-secret
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_REFRESH_COOKIE_SECURE=false
APP_SEED_DEMO_DATA=true
